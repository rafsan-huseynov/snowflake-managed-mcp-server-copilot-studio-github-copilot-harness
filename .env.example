# Copy to .env and fill in YOUR values. NEVER commit .env (it's gitignored).
TENANT_ID=<your-tenant-id>
RESOURCE_APP_CLIENT_ID=<resource-app-client-id>
CLIENT_APP_CLIENT_ID=<client-app-client-id>
# Client secret: do NOT store in the repo. Use a secret manager.
# CLIENT_SECRET=

SNOWFLAKE_HOST=<org>-<account>.snowflakecomputing.com
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
DELEGATE_USER_UPN=<user@yourtenant.onmicrosoft.com>
